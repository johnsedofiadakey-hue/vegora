# Public Firebase web app identifiers (safe for browser use)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase service account and Storage bucket
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Test-mode payment only. Never place this secret in NEXT_PUBLIC_ variables.
PAYSTACK_SECRET_KEY=
# HTTPS origin hosting /checkout/return and /api/paystack/webhook
VEGORA_SITE_URL=
# Approved JSON array of {id,label,region,cities?,feeMinor}; no rates are supplied by default.
VEGORA_DELIVERY_ZONES_JSON=
# Random server-only secret, at least 32 characters, for the scheduled expiry endpoint.
VEGORA_CRON_SECRET=

# Leave these unset until the test webhook, expiry scheduler, delivery rates,
# and synthetic end-to-end reconciliation have been verified.
VEGORA_WEBHOOK_CONFIRMED=
VEGORA_EXPIRY_JOB_CONFIRMED=
VEGORA_CHECKOUT_ENABLED=
